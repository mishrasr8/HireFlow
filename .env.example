# Hireflow environment configuration
#
# Copy this file to `.env` in the repository root and adjust the values.
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file is committed and
# must never contain a real secret. Only variables that Phase 1 actually needs
# are listed -- placeholders for future features are deliberately absent.

# Runtime mode: "development" or "production".
# Controls error verbosity (stack traces are only exposed in development).
NODE_ENV=development

# TCP port the Express API listens on.
PORT=4000

# MongoDB connection string.
# The default below is a local, credential-free development database.
# A hosted or production database will contain a username and password --
# those belong in your uncommitted `.env`, never in this file.
MONGODB_URI=mongodb://127.0.0.1:27017/hireflow

# Browser origins permitted to call the API (comma-separated).
# Must list the frontend origin exactly, including scheme and port, because the
# API will be called with credentials. The wildcard "*" is deliberately not used:
# see docs/architecture.md for why that matters.
CORS_ORIGINS=http://localhost:5173

# Base URL the browser uses to reach the API.
# Read by the web app at build time; it is public, so it is not a secret.
VITE_API_BASE_URL=http://localhost:4000
